[Unit]
Description=Servlo Nginx Web Server
After=network.target

[Container]
Image=docker.io/library/nginx:alpine
ContainerName=servlo-nginx
Network=servlo
PublishPort=80:80
PublishPort=443:443
Volume=%h/.local/share/servlo/nginx/nginx.conf:/etc/nginx/nginx.conf:ro,z
Volume=%h/.local/share/servlo/nginx/conf.d:/etc/nginx/conf.d:ro,z
Volume=%h/.local/share/servlo/nginx/custom.d:/etc/nginx/custom.d:ro,z
Volume=%h/.local/share/servlo/nginx/http.d:/etc/nginx/http.d:ro,z
Volume=%h/.local/share/servlo/certs/sites:/etc/nginx/certs:ro,z
Volume=%h/.local/share/servlo/run:%h/.local/share/servlo/run:rw
Volume=%h:%h:ro
PodmanArgs=--security-opt=label=disable

[Service]
Restart=always

[Install]
WantedBy=default.target
