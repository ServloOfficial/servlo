[Unit]
Description=Servlo Nginx Web Server
After=network.target

[Container]
Image=docker.io/library/nginx:alpine
ContainerName=servlo-nginx
Network=servlo
PublishPort=80:80
PublishPort=443:443
Volume=%h/.local/share/servlo/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
Volume=%h/.local/share/servlo/nginx/conf.d:/etc/nginx/conf.d:ro
Volume=%h/.local/share/servlo/certs/sites:/etc/nginx/certs:ro

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
